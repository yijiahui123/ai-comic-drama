# AI Comic Drama — Environment Variables
# Copy this file to .env and edit as needed.
# All variables are optional; YAML configs are used as fallback.

# --- Service URLs ---
# AI_COMIC_LLM_URL=http://127.0.0.1:8000/v1
# AI_COMIC_LLM_MODEL=Qwen3.6-35B-A3B-MLX-8bit
# AI_COMIC_LLM_API_KEY=your-key-here
# AI_COMIC_COMFYUI_URL=http://localhost:8188
# AI_COMIC_CHATTTS_URL=http://localhost:9966
# AI_COMIC_SADTALKER_URL=http://localhost:7860

# --- Web Server ---
# AI_COMIC_HOST=0.0.0.0
# AI_COMIC_PORT=8080

# --- Logging ---
# Values: DEBUG, INFO, WARNING, ERROR
# AI_COMIC_LOG_LEVEL=INFO

# --- Feature Flags ---
# Set to "1" to enable real model execution (LLM, ComfyUI)
# AI_COMIC_ENABLE_MODEL_TASKS=0
